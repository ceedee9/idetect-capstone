# ============================================================
# iDetect API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idetect
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Secrets (make these long random strings — one per portal)
JWT_SECRET_STAFF=change_me_to_a_random_string
JWT_SECRET_ESTABLISHMENT=change_me_to_a_random_string
JWT_SECRET_BENEFICIARY=change_me_to_a_random_string
JWT_EXPIRES_IN=8h

# SMS (Semaphore) — leave blank to log OTPs to console
SMS_PROVIDER=semaphore
SMS_API_KEY=
SMS_SENDER_NAME=iDetect

# Cloudinary (image storage) — optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OCR confidence threshold (0-100)
# Scans below this score trigger manual_review
OCR_CONFIDENCE_THRESHOLD=75

# Beneficiary import limit
BENEFICIARY_IMPORT_MAX_ROWS=20000

# CORS — comma-separated origins for production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Firebase (FCM push notifications) — free, no per-message cost
# 1. Go to https://console.firebase.google.com
# 2. Project Settings → Service Accounts → Generate new private key
# 3. Save the JSON file and set the path below (relative to apps/api/)
# Falls back to console logging if not set (safe for demo without Firebase)
FIREBASE_KEY_PATH=path/to/firebase-service-account.json
