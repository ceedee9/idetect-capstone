# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node.js dependencies — never commit these
node_modules/
**/node_modules/

# Web portal build outputs
apps/web-bplo/dist/
apps/web-osca/dist/
apps/web-pdao/dist/

# Beneficiary app build
apps/beneficiary/build/
apps/beneficiary/.dart_tool/

# Uploaded ID images (runtime data, not source code)
apps/api/uploads/

# Environment variables and secrets — NEVER commit these
apps/api/.env
apps/api/*-adminsdk-*.json
apps/api/firebase-service-account.json
