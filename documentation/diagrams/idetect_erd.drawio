<mxfile host="app.diagrams.net" version="24.7.0">
  <diagram name="ERD - iDetect (10 tables)" id="erd-idetect">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ USERS ============ -->
        <mxCell id="tbl_users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr size=1&gt;- id : UUID &amp;lt;&amp;lt;PK&amp;gt;&amp;gt;&lt;br&gt;email : VARCHAR(255) UNIQUE&lt;br&gt;password_hash : VARCHAR(255)&lt;br&gt;full_name : VARCHAR(255)&lt;br&gt;role : ENUM(bplo_admin,osca_admin,pdao_admin)&lt;br&gt;is_active : BOOLEAN&lt;br&gt;failed_attempts : SMALLINT&lt;br&gt;locked_until : TIMESTAMPTZ&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;updated_at : TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="900" y="20" width="300" height="200" as="geometry" />
        </mxCell>

        <!-- ============ ESTABLISHMENTS ============ -->
        <mxCell id="tbl_establishments" value="&lt;b&gt;ESTABLISHMENTS&lt;/b&gt;&lt;hr size=1&gt;- id : UUID &amp;lt;&amp;lt;PK&amp;gt;&amp;gt;&lt;br&gt;email : VARCHAR(255) UNIQUE&lt;br&gt;password_hash : VARCHAR(255)&lt;br&gt;business_name : VARCHAR(255)&lt;br&gt;business_permit_no : VARCHAR(100) UNIQUE&lt;br&gt;business_permit_expiry : DATE&lt;br&gt;owner_name : VARCHAR(255)&lt;br&gt;address : TEXT&lt;br&gt;contact_number : VARCHAR(20)&lt;br&gt;business_type : VARCHAR(100)&lt;br&gt;status : ENUM(pending,approved,suspended,revoked)&lt;br&gt;approved_by : UUID &amp;lt;&amp;lt;FK--USERS, nullable&amp;gt;&amp;gt;&lt;br&gt;approved_at : TIMESTAMPTZ&lt;br&gt;suspended_reason : TEXT&lt;br&gt;failed_attempts : SMALLINT&lt;br&gt;locked_until : TIMESTAMPTZ&lt;br&gt;reset_otp : VARCHAR(6)&lt;br&gt;reset_otp_expires : TIMESTAMPTZ&lt;br&gt;password_setup_token : VARCHAR(64)&lt;br&gt;password_setup_token_expires : TIMESTAMPTZ&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;updated_at : TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="340" height="380" as="geometry" />
        </mxCell>

        <!-- ============ BENEFICIARIES ============ -->
