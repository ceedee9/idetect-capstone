        <!-- ============ FRAUD_FLAGS ============ -->
        <mxCell id="tbl_fraud_flags" value="&lt;b&gt;FRAUD_FLAGS&lt;/b&gt;&lt;hr size=1&gt;- id : UUID &amp;lt;&amp;lt;PK&amp;gt;&amp;gt;&lt;br&gt;verification_log_id : UUID &amp;lt;&amp;lt;FK--VERIFICATION_LOGS&amp;gt;&amp;gt;&lt;br&gt;establishment_id : UUID &amp;lt;&amp;lt;FK--ESTABLISHMENTS&amp;gt;&amp;gt;&lt;br&gt;beneficiary_id : UUID &amp;lt;&amp;lt;FK--BENEFICIARIES, nullable&amp;gt;&amp;gt;&lt;br&gt;id_number_flagged : VARCHAR(50)&lt;br&gt;beneficiary_type : ENUM(senior_citizen,pwd)&lt;br&gt;flag_status : ENUM(pending,reviewing,confirmed,dismissed)&lt;br&gt;establishment_notes : TEXT&lt;br&gt;staff_notes : TEXT&lt;br&gt;reviewed_by : UUID &amp;lt;&amp;lt;FK--USERS, nullable&amp;gt;&amp;gt;&lt;br&gt;image_path : TEXT&lt;br&gt;verification_outcome : ENUM(valid,suspicious,invalid,manual_review)&lt;br&gt;parent_flag_id : UUID &amp;lt;&amp;lt;FK--FRAUD_FLAGS, nullable&amp;gt;&amp;gt;&lt;br&gt;is_supplementary : BOOLEAN&lt;br&gt;flagged_at : TIMESTAMPTZ&lt;br&gt;reviewed_at : TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
