        <mxCell id="note1" value="NOTE: Corrected from prior version — renamed FRAUD_LOGS to FRAUD_FLAGS (actual table name), added disability_type, PIN fields, OCR cross-validation fields, lockout/reset fields, and the previously-missing 10th table STAFF_ALERTS (migration 022, used by fraudFlags.js / slaEscalationScheduler.js / staff.js)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#B85450;fillColor=#fff2cc;strokeColor=#B85450;" vertex="1" parent="1">
