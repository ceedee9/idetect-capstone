    <mxCell id="note25" value="Detect ID type (Senior Citizen / PWD).&#xa;Extract: Full Name, ID Number, DOB,&#xa;Age (auto-calc), Sex, Date Issued,&#xa;Control Number" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
