         ANNOTATION NOTES (quality thresholds / pipeline steps)
    ═══════════════════════════════════════════════════════════════ -->
    <mxCell id="note21" value="Quality checks: resolution &gt;2MP,&#xa;brightness 80–180, sharpness,&#xa;contrast; auto-crop 1.586:1 ratio" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="40" y="195" width="220" height="50" as="geometry" />
    </mxCell>
    <mxCell id="note22" value="Resize 2000px → border removal →&#xa;perspective correction → deskew&#xa;(Hough) → grayscale → bilateral&#xa;filter → CLAHE → sharpen →&#xa;adaptive threshold → morphological ops" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="40" y="345" width="220" height="65" as="geometry" />
    </mxCell>
    <mxCell id="note23" value="Tesseract (primary, PSM Mode 6,&#xa;95–98% accuracy) + Google ML Kit&#xa;(fallback, 85–90%). Best result&#xa;selected by confidence score." style="text;html=1;strokeColor=#AAAAAA;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="40" y="500" width="220" height="55" as="geometry" />
    </mxCell>
    <mxCell id="note24" value="Fix O→0, I→1; standardize dates;&#xa;fix ID number format; title-case&#xa;names; remove noise characters" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="40" y="655" width="220" height="50" as="geometry" />
